# Shu faylni ".env" nomi bilan nusxalang va to'ldiring. .env ni hech kimga yubormang!
BOT_TOKEN=
# So'rovlar keladigan chat (shaxsiy ID yoki guruh ID, guruh odatda -100 bilan boshlanadi)
ADMIN_CHAT_ID=
# /stat va boshqa admin buyruqlari ishlaydigan foydalanuvchi ID lari, vergul bilan
ADMIN_IDS=
# Sayt formasi uchun HTTP server
LEAD_HOST=0.0.0.0
LEAD_PORT=8080
# Saytingiz manzili, masalan https://avtomaximus.uz  (bilmasangiz * qoldiring)
ALLOWED_ORIGIN=*
